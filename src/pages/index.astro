---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { site } from '../data/site';
import { series as allSeries } from '../data/series';
import { categories } from '../data/categories';
import { getPublishedPosts, getSeriesRoster } from '../lib/posts';

const activeSeries = allSeries.find((s) => s.status === 'em-andamento') ?? null;
const seriesRoster = activeSeries ? await getSeriesRoster(activeSeries) : [];

const latestPosts = (await getPublishedPosts()).slice(0, 6);
---

<Base title={site.name} description={site.description}>
  <section class="hero">
    <h1>{site.name}</h1>
    <p class="tagline">{site.tagline}</p>
    <p class="measure">
      Cada conceito novo é ancorado em algo que você já usa, detalhado a
      partir dali, e situado onde importa: no que ele muda no seu dia a dia.
    </p>
    <p class="measure">
      Escrevo a partir do que uso em projeto, incluindo o que não funcionou.
    </p>
  </section>

  <section class="topics">
    <h2>O que você encontra aqui</h2>
    <ul class="topic-grid">
      {
        categories.map((category) => (
          <li class="topic-tile" style={{ '--category-accent': category.accent }}>
            <a class="topic-link" href="/blog">
              <span class="topic-label">{category.label}</span>
              <p class="topic-description">{category.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    activeSeries && seriesRoster.length > 0 && (
      <section class="series-block">
        <h2>{activeSeries.title}</h2>
        <p class="series-description measure">{activeSeries.description}</p>
        <ol class="series-list">
          {seriesRoster.map((entry) => (
            <li>
              <span class="series-order">{entry.order}</span>
              {entry.href ? (
                <a href={entry.href}>{entry.title}</a>
              ) : (
                <span class="series-title-pending">{entry.title}</span>
              )}
            </li>
          ))}
        </ol>
        <a class="series-link" href={`/serie/${activeSeries.slug}`}>
          Ver a série completa
        </a>
      </section>
    )
  }

  <section class="latest-posts">
    <h2>Últimos posts</h2>
    <ul class="posts">
      {latestPosts.map((post) => <PostCard post={post} />)}
    </ul>
    <a class="all-posts-link" href="/blog">Ver todos os artigos</a>
  </section>
</Base>

<style>
  section + section {
    margin-top: 3.5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--rule);
  }

  .hero h1 {
    font-size: clamp(2.25rem, 5vw, 3rem);
    margin-bottom: 0.75rem;
  }

  .hero .tagline {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

  .hero p + p {
    margin-top: 0.75rem;
  }

  .topics h2,
  .series-block h2,
  .latest-posts h2 {
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    list-style: none;
    margin-top: 1.25rem;
  }

  @media (max-width: 40rem) {
    .topic-grid {
      grid-template-columns: 1fr;
    }
  }

  .topic-tile {
    position: relative;
    border: 1px solid var(--ink);
    border-radius: 4px;
    background: var(--card);
    overflow: hidden;
    transition:
      background-color 120ms,
      border-color 120ms;
  }

  .topic-tile::before {
    content: '';
    display: block;
    height: 3px;
    background: var(--category-accent);
  }

  .topic-tile:hover {
    background: #ffffff;
    border-color: var(--known-deep);
  }

  .topic-tile:has(a:focus-visible) {
    outline: 2px solid var(--known);
    outline-offset: 2px;
  }

  .topic-link {
    display: block;
    padding: 1rem;
    color: var(--ink);
    text-decoration: none;
  }

  .topic-label {
    display: block;
    font-family: var(--font-sans);
    font-weight: 600;
    margin-bottom: 0.4rem;
  }

  .topic-description {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .series-description {
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  .series-list {
    list-style: none;
  }

  .series-list li {
    display: flex;
    gap: 0.75rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--rule);
  }

  .series-list li:first-child {
    padding-top: 0;
  }

  .series-order {
    font-family: var(--font-mono);
    color: var(--muted);
    min-width: 1.5em;
  }

  .series-list a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: currentColor;
  }

  .series-title-pending {
    color: var(--muted);
  }

  .series-link {
    display: inline-block;
    margin-top: 1.25rem;
    font-family: var(--font-sans);
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: currentColor;
  }

  .all-posts-link {
    display: inline-block;
    margin-top: 1.5rem;
    font-family: var(--font-sans);
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: currentColor;
  }
</style>
