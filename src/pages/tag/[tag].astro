---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { site } from '../../data/site';
import { getTagGroups, type TagGroup } from '../../lib/posts';

export async function getStaticPaths() {
  const groups = await getTagGroups();
  return groups.map((group) => ({
    params: { tag: group.slug },
    props: { tag: group.tag, posts: group.posts },
  }));
}

interface Props {
  tag: TagGroup['tag'];
  posts: TagGroup['posts'];
}

const { tag, posts } = Astro.props;
---

<Base title={`#${tag}`} description={`Posts com a tag "${tag}" no ${site.name}.`}>
  <h1>#{tag}</h1>
  <p class="count">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>

  <ul class="posts">
    {posts.map((post) => <PostCard post={post} />)}
  </ul>
</Base>

<style>
  h1 {
    margin-bottom: 0.5rem;
  }

  .count {
    font-family: var(--font-sans);
    color: var(--muted);
    margin-bottom: 2rem;
  }

</style>
