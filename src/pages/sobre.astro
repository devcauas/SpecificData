---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const skills = [
  'Machine learning aplicado — modelagem preditiva com Scikit-learn, do pré-processamento à avaliação de métricas',
  'IA generativa e RAG — pipelines com LangChain, ChromaDB, embeddings e LLM local via Ollama',
  'Análise e engenharia de dados — Pandas, NumPy, SQL e modelagem relacional',
  'Automação de processos — Power Automate, integrando rotinas que antes eram manuais',
];

const stack = [
  'Python — Pandas, NumPy, Scikit-learn, Matplotlib, Seaborn',
  'FastAPI, LangChain, ChromaDB, Streamlit',
  'SQL, PostgreSQL, SQLite, DBDiagram',
  'Azure, Databricks, Docker, Git e GitHub',
  'HTML, CSS, JavaScript, Astro',
];

const projects = [
  
  {
    title: 'Azure Cost Estimator',
    url: 'https://github.com/devcauas/azure-cost-estimator',
    description:
      'Ferramenta web, feita em dupla no Programa Aceleras (Dataside), que estima custos de soluções Azure + Databricks por serviço e por ambiente. Preços obtidos por engenharia reversa de orçamentos oficiais e validados contra casos reais com desvios de −2,1% e +4,2%, com teste de regressão automatizado e preenchimento a partir de texto livre (beta).',
  },
  {
    title: 'S4Lake: Order-to-Cash',
    url: 'https://github.com/devcauas/s4lake-order-to-cash',
    description:
      'Arquitetura de referência SAP + Databricks para contas a receber: pipeline Bronze → Silver → Gold com PySpark e Delta Lake, quarentena de registros inválidos, reconciliação linha a linha e KPIs de DSO e aging. Próxima etapa: modelo de risco de atraso de pagamento.',
  },
  {
    title: 'Spotify FAQ Chatbot',
    url: 'https://github.com/devcauas/spotify_faq_chatbot',
    description:
      'Chatbot com pipeline RAG rodando 100% local sobre a Central de Ajuda do Spotify: scraping da documentação, embeddings com Sentence Transformers, banco vetorial ChromaDB e respostas via Llama 3.2 no Ollama. Backend em FastAPI, frontend em Streamlit, containerizado com Docker.',
  },
  {
    title: 'Análise Estatística e Preditiva do Varejo',
    url: 'https://github.com/devcauas/analise_estatistica_varejo',
    description:
      'Estudo estatístico e de machine learning sobre transações do varejo, incluindo dados do mercado brasileiro: análise exploratória, identificação de outliers, desempenho por segmento ao longo do tempo e regras de associação com FP-Growth para recomendar produtos a partir do carrinho.',
  },
];
---

<Base
  title="Sobre"
  description={`Sobre o ${site.name}: apresentação, habilidades, stack e contato de ${site.author.name}.`}
>
  <h1>Sobre</h1>

  <section class="block intro measure">
    <h2>Apresentação</h2>
    <p>
      Sou Cauã Souza Almeida, Analista e Cientista de Dados, graduado em Análise e
      Desenvolvimento de Sistemas pela FATEC. Trabalho com análise de
      dados, automação de processos e cloud. Estudo e pratico principalmente
      modelagem preditiva e arquiteturas RAG, ligando modelo, dado e API 
      em aplicações que rodam de ponta a ponta.
    </p>
  </section>

  <section class="block measure">
    <h2>Habilidades</h2>
    <ul class="plain-list">
      {skills.map((skill) => <li>{skill}</li>)}
    </ul>
  </section>

  <section class="block measure">
    <h2>Stack e ferramentas</h2>
    <ul class="plain-list">
      {stack.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="block measure">
    <h2>Projetos</h2>
    <ul class="project-list">
      {
        projects.map((project) => (
          <li>
            <p class="project-title">
              {project.url ? (
                <a href={project.url} rel="noopener noreferrer">
                  {project.title}
                </a>
              ) : (
                project.title
              )}
            </p>
            <p class="project-description">{project.description}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="block measure">
    <h2>Contato</h2>
    <p>
      <a href={site.author.github} rel="noopener noreferrer">GitHub</a> ·{' '}
      <a href={site.author.linkedin} rel="noopener noreferrer">LinkedIn</a> ·{' '}
      <a href={`mailto:${site.author.email}`}>E-mail</a>
    </p>
  </section>
</Base>

<style>
  h1 {
    margin-bottom: 2rem;
  }

  .block + .block {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .block h2 {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }

  .intro p + p {
    margin-top: 1rem;
  }

  .block a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: currentColor;
  }

  .plain-list {
    list-style: none;
  }

  .plain-list li {
    padding-block: 0.4rem;
    border-bottom: 1px solid var(--rule);
    color: var(--muted);
  }

  .plain-list li:first-child {
    padding-top: 0;
  }

  .plain-list li:last-child {
    border-bottom: none;
  }

  .project-list {
    list-style: none;
  }

  .project-list li + li {
    margin-top: 1.25rem;
  }

  .project-title {
    font-family: var(--font-sans);
    font-weight: 600;
  }

  .project-description {
    margin-top: 0.25rem;
    color: var(--muted);
  }
</style>
