---
import Head from '../components/Head.astro';
import Logo from '../components/Logo.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  updatedDate?: Date;
  image?: string;
}

const { title, description, type, publishedDate, updatedDate, image } = Astro.props;

const currentPath = Astro.url.pathname;
const navLinks = [
  { href: '/', label: 'Início' },
  { href: '/sobre', label: 'Sobre' },
];

function isActiveLink(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath === `${href}/`;
}
---

<html lang="pt-BR">
  <head>
    <Head
      title={title}
      description={description}
      type={type}
      publishedDate={publishedDate}
      updatedDate={updatedDate}
      image={image}
    />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    <header class="site-header">
      <div class="container">
        <div class="brand">
          <a href="/" class="logo-link" aria-label={`${site.name} — página inicial`}>
            <Logo size={28} />
            <span class="brand-name">{site.name}</span>
          </a>
          <p class="header-tagline">{site.headerTagline}</p>
        </div>
        <nav>
          {
            navLinks.map((link) => (
              <a href={link.href} aria-current={isActiveLink(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="conteudo" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>{site.author.name}</p>
        <nav>
          <a href={site.author.github} rel="noopener noreferrer">GitHub</a>
          <a href={site.author.linkedin} rel="noopener noreferrer">LinkedIn</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .container {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .site-header,
  .site-footer {
    font-family: var(--font-sans);
  }

  .site-header .container,
  .site-footer .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .site-header {
    border-bottom: 1px solid var(--rule);
    padding-block: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    color: var(--ink);
    text-decoration: none;
  }

  .brand-name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .header-tagline {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  @media (max-width: 40rem) {
    .header-tagline {
      display: none;
    }
  }

  .site-header nav,
  .site-footer nav {
    display: flex;
    gap: 1.25rem;
  }

  .site-header nav a,
  .site-footer nav a {
    text-decoration: none;
    color: var(--muted);
  }

  .site-header nav a:hover,
  .site-footer nav a:hover {
    color: var(--ink);
  }

  .site-header nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--known);
    text-decoration-thickness: 2px;
  }

  .skip-link {
    position: absolute;
    top: -3rem;
    left: 0.5rem;
    z-index: 10;
    padding: 0.5rem 1rem;
    background: var(--card);
    color: var(--ink);
    border: 1px solid var(--ink);
    font-family: var(--font-sans);
    text-decoration: none;
  }

  .skip-link:focus-visible {
    top: 0.5rem;
  }

  main {
    padding-block: 2rem;
    min-height: 60vh;
  }

  .site-footer {
    border-top: 1px solid var(--rule);
    padding-block: 1.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
