---
interface Props {
  class?: string;
  size?: number;
}

const { class: className, size = 24 } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="16" cy="16" r="13" />
  <circle cx="16" cy="16" r="8.5" />
  <circle cx="16" cy="16" r="4" />
  <path d="M29 3 L16 16 M16 16 L20.8 14.7 M16 16 L17.3 11.2" />
</svg>
