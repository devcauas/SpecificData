<div class="prose">
  <slot />
</div>

<style is:global>
  .prose {
    display: grid;
    grid-template-columns: min(68ch, 100%) 1fr;
    color: var(--ink);
    background: var(--paper);
    line-height: 1.7;
  }

  .prose > * {
    grid-column: 1;
  }

  /* ---------- vertical rhythm ---------- */

  .prose > * + * {
    margin-top: 1.25em;
  }

  .prose > h2,
  .prose > h3 {
    font-family: var(--font-sans);
    margin-top: 2.5em;
    margin-bottom: 0.6em;
  }

  .prose > h2 + *,
  .prose > h3 + * {
    margin-top: 0;
  }

  /* ---------- lists ---------- */

  .prose ul,
  .prose ol {
    padding-left: 1.5em;
  }

  .prose ul {
    list-style: disc;
  }

  .prose ol {
    list-style: decimal;
  }

  .prose li + li {
    margin-top: 0.4em;
  }

  /* ---------- links ---------- */

  .prose a {
    color: var(--known);
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-underline-offset: 0.15em;
  }

  .prose a:hover {
    color: var(--known-deep);
  }

  /* ---------- heading anchors ---------- */

  .prose h2,
  .prose h3,
  .prose h4 {
    position: relative;
  }

  .prose .heading-anchor {
    position: absolute;
    left: -1.1em;
    text-decoration: none;
    color: var(--muted);
    opacity: 0;
  }

  .prose h2:hover .heading-anchor,
  .prose h3:hover .heading-anchor,
  .prose h4:hover .heading-anchor,
  .prose h2:focus-within .heading-anchor,
  .prose h3:focus-within .heading-anchor,
  .prose h4:focus-within .heading-anchor {
    opacity: 1;
  }

  /* ---------- code ---------- */

  .prose code {
    background: var(--code-bg);
    border: none;
    border-radius: 3px;
    padding: 0.15em 0.4em;
    font-size: 0.9em;
  }

  .prose pre {
    grid-column: 1 / -1;
    max-width: 100%;
    overflow-x: auto;
    padding: 1rem 1.25rem;
    border-radius: 3px;
  }

  .prose pre code {
    background: none;
    border: none;
    border-radius: 0;
    padding: 0;
    font-size: 0.9em;
  }

  /* ---------- blockquote ---------- */

  .prose blockquote {
    border-left: 2px solid var(--rule);
    padding-left: 1.25em;
  }

  /* ---------- table ---------- */

  .prose table {
    grid-column: 1 / -1;
    max-width: 100%;
    border-collapse: collapse;
    display: block;
    overflow-x: auto;
  }

  .prose th,
  .prose td {
    text-align: left;
    padding: 0.5em 1em 0.5em 0;
    border-bottom: 1px solid var(--rule);
  }

  .prose th {
    font-family: var(--font-sans);
    border-bottom: 1px solid var(--ink);
  }

  /* ---------- figure / image ---------- */

  .prose figure {
    grid-column: 1 / -1;
    max-width: min(68ch, 100%);
  }

  .prose figcaption {
    margin-top: 0.5em;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.9em;
  }
</style>
