---
import { Image } from 'astro:assets';
import type { Post } from '../lib/posts';
import { getCategory } from '../data/categories';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { data, id } = post;
const category = getCategory(data.category);

const dateFormatter = new Intl.DateTimeFormat('pt-BR', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
---

<li class="post-card" data-category={data.category}>
  {
    data.cover && (
      <a href={`/blog/${id}`} class="post-card-cover" tabindex="-1" aria-hidden="true">
        <Image src={data.cover} alt="" width={600} height={400} format="webp" loading="lazy" />
      </a>
    )
  }
  <p class="post-card-meta">
    <span class="post-card-category">{category.label}</span>
    <span aria-hidden="true"> · </span>
    <time datetime={data.date.toISOString()}>{dateFormatter.format(data.date)}</time>
  </p>
  <a class="post-card-title" href={`/blog/${id}`}>{data.title}</a>
  <p class="post-card-description">{data.description}</p>
</li>

<style>
  .post-card {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .post-card:first-child {
    padding-top: 0;
  }

  .post-card-cover {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 3px;
    margin-bottom: 0.85rem;
  }

  .post-card-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-card-meta {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--muted);
  }

  .post-card-category {
    text-transform: lowercase;
  }

  .post-card-title {
    display: inline-block;
    margin-top: 0.4rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.15em;
  }

  .post-card-title:hover {
    text-decoration-color: currentColor;
  }

  .post-card-description {
    margin-top: 0.4rem;
    color: var(--muted);
  }
</style>
