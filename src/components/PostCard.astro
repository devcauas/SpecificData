---
import { Image } from 'astro:assets';
import type { Post } from '../lib/posts';
import { getCategory } from '../data/categories';
import { getReadingTime } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { data, id, body } = post;
const category = getCategory(data.category);
const readingTime = getReadingTime(body ?? '');

const dateFormatter = new Intl.DateTimeFormat('pt-BR', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
---

<li
  class="post-card"
  data-category={data.category}
  style={{ '--category-accent': category.accent }}
>
  {
    data.cover && (
      <div class="post-card-cover">
        <Image
          src={data.cover}
          alt=""
          widths={[320, 480, 640]}
          sizes="(max-width: 40rem) 100vw, 20rem"
          format="webp"
          loading="lazy"
        />
      </div>
    )
  }
  <p class="post-card-meta">
    <span class="post-card-category">{category.label}</span>
    <span aria-hidden="true"> · </span>
    <time datetime={data.date.toISOString()}>{dateFormatter.format(data.date)}</time>
  </p>
  <a class="post-card-title" href={`/blog/${id}`}>{data.title}</a>
  <p class="post-card-description">{data.description}</p>
  <p class="post-card-time">{readingTime} min</p>
</li>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--ink);
    border-radius: 4px;
    overflow: hidden;
    transition:
      background-color 120ms,
      border-color 120ms;
  }

  .post-card::before {
    content: '';
    display: block;
    height: 3px;
    background: var(--category-accent);
  }

  .post-card:hover {
    background: #ffffff;
    border-color: var(--known-deep);
  }

  .post-card:has(a:focus-visible) {
    outline: 2px solid var(--known);
    outline-offset: 2px;
  }

  .post-card-cover {
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .post-card-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-card-meta {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0.85rem 1rem 0;
  }

  .post-card-category {
    text-transform: lowercase;
  }

  .post-card-title {
    display: block;
    margin: 0.4rem 1rem 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--ink);
    text-decoration: none;
  }

  .post-card-title::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post-card-description {
    flex: 1;
    margin: 0.5rem 1rem 0;
    color: var(--muted);
    font-size: 0.95rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-time {
    margin: 0.75rem 1rem 1rem;
    color: var(--muted);
    font-size: 0.8rem;
  }
</style>
