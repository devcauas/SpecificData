{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "specificdata",
  "compatibility_date": "2026-09-04",
  "preview_urls": false,
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
