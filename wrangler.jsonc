{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "specificdata",
  "compatibility_date": "2026-09-04",
  "preview_urls": false,
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
